{
  "name": "otetsudai-points",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:rules": "firebase emulators:exec --only firestore --project demo-guild \"vitest run --config vitest.rules.config.ts\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "firebase emulators:exec --only auth,firestore --project demo-guild \"playwright test --config playwright.firebase.config.ts\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^13.35.1",
    "jsdom": "^25.0.1",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  }
}
